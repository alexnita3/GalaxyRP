
holocomm
{
	name		"^3Holo Communicator"
	saberType	SABER_SITH_SWORD
	saberModel	"models/weapons2/Holocomm/Holocomm.glm"
	soundOn		none
	soundLoop	"sound/weapons/sword/servo_hand.wav"
	soundOff	none
	saberLength		50
	saberColor		random
	damageScale 	0.05
    noBlade         1
    saberRadius     3
    maxChain        0
    lockable        0
    forcerestrict   0
    lockbonus       1
    parrybonus      1
    breakparrybonus  1
    throwable       0
    disarmable      0
    blocking        0
    twohanded       0
    bounceOnWalls   0 
    readyAnim               BOTH_OBJECT
    noWallMarks     1
    noDlight        1
    trailStyle      2
	noPullAttack 	1
	noRollStab 		1
	noBackAttack 	1
	noStabDown 		1
	noCartwheels 1
	noClashFlare 	1
	noIdleEffect	1
	kataMove 		LS_NONE
	lungeAtkMove 	LS_NONE
	jumpAtkFwdMove 	LS_NONE
	noManualDeactivate 1
	onInWater		1
	hitPersonEffect	none
	g2MarksShader	none
	blockEffect		"sparks/spark.efx"	
	hitOtherEffect	"sparks/spark.efx"
	spinsound	"sound/weapons/sword/spin.mp3"
    swingsound1             "sound/weapons/metal/swing1.wav"
    swingsound2             "sound/weapons/metal/swing2.wav"
    swingsound3             "sound/weapons/metal/swing3.wav"
    fallsound1              "sound/weapons/metal/fall1.wav"
    fallsound2              "sound/weapons/metal/fall1.wav"
    fallsound3              "sound/weapons/metal/fall1.wav"
    hitsound1               "sound/weapons/metal/slam1.wav"
    hitsound2               "sound/weapons/metal/slam1.wav"
    hitsound3               "sound/weapons/metal/slam1.wav"
	blocksound1		"sound/weapons/sword/block1.mp3"
	blocksound2		"sound/weapons/sword/block2.mp3"
	blocksound3		"sound/weapons/sword/block3.mp3"
	bounceSound1	"sound/weapons/sword/fall1.mp3"
	bounceSound2	"sound/weapons/sword/fall1.mp3"
