//------------------------------------------------------------------------------------------------
// PLAYER SETUP MENU  - ingame_player
//
//	Choose player skin, name
//	Choose light saber
//	Allocate force powers
//
//	g_gametypes
//		"Free For All" 		0
//		"Duel" 			3
//		"Power Duel" 		4
//		"Team FFA" 		6 
//		"Siege" 		7
//		"Capture the Flag" 	8
//
//	ui_net_gametype
//		0 = FFA
//		1 = DUEL
//		2 = POWER DUEL
//		3 = TEAM FFA
//		4 = SIEGE
//		5 = CTF
//------------------------------------------------------------------------------------------------
{
	menuDef 
	{
		name						"ingame_player"
		visible						0
		fullscreen					0
		outOfBoundsClick										// this closes the window if it gets a click out of the rectangle
		rect						195 140 250 172		// GalaxyRP: [Profile UI] Join/Auto team/Red/Blue/Spectate moved back to the top-bar Join menu;
											// a "Join or Spectate" button below Logout/Change Pass reopens that same menu from here.
											// Sized to center the three rows (y=40/70/100, 92px tall) with equal 40px margins above
											// and below
		focusColor					1 1 1 1					// Focus color for text and items
		style						1
		border						1
		// GalaxyRP fix: [UI] descX/descY/descScale/descColor/descAlignment removed -- they positioned
		// tooltip (descText) content at fixed coordinates that landed well outside this menu's own
		// 250x172 window rect. Since descText has been removed from every itemDef below, these settings
		// no longer do anything and are dropped rather than left as unused dead config.
		onOpen
		{
			uiScript				updateForceStatus
			// GalaxyRP: [Profile UI] refreshes ui_loggedin (see CG_LoggedInUpdate_f / Cmd_GalaxyRpUi_f)
			// so the Register/Login vs Logout/Change Pass gating below reflects the player's actual
			// current login state every time this menu is opened, instead of whatever it was last set
			// to by the separate Profile menu.
			exec					"zykmod" ;
			hide					highlights
		}
		onClose
		{
			uiScript				updateForceStatus
			hide					highlights
		}

//------------------------------------------------------------------------------------------------
// Overall window backdrop
//------------------------------------------------------------------------------------------------
		itemDef 
		{
			name				background_pic
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 250 172
			background			"gfx/menus/menu_box_ingame"
			forecolor			1 1 1 1
			visible				1
			decoration
		}


		// Button background at bottom of screen
		itemDef 
		{
			name				background
			group				none
			style				WINDOW_STYLE_FILLED
			rect				0 420 600 20
			backcolor			.298 .305 .690 1
			forecolor			.549 .854 1 1
			visible				1
			decoration
		}

// GalaxyRP: [Profile UI] the player-name entry field that used to live here was removed -- it
// duplicated the one already on the ingame_galaxyrp menu (same "ui_Name" cvar, same
// ui_GetName/ui_SetName sync), so there is no need to maintain two copies.
// GalaxyRP: [Profile UI] Register/Login (logged-out) and Logout/Change Pass (logged-in) now share the
// same two slots (y=40 and y=70) instead of all three always showing at once regardless of login
// state -- gated on ui_loggedin (kept fresh by the exec "zykmod" added to onOpen above). Only one pair
// is ever visible for a given player.

//REGISTER BUTTON (logged-out, slot 1)
		itemDef
		{
			name				registerButton
			group				highlights
			style				WINDOW_STYLE_SHADER
			rect				73 40 105 32
			background			"gfx/menus/menu_buttonback"			// Frame around button
			forecolor			1 1 1 1
			decoration
			visible			0
			cvartest			"ui_loggedin"
			showcvar			{ "0" }
		}

		itemDef
		{
			name				register
			group				none
			text				"Register"
			type				1
			style				WINDOW_STYLE_EMPTY
			rect				73 40 105 32
			textalign			ITEM_ALIGN_CENTER
			textalignx			52
			textaligny			2
			font				2
			textscale			1
			forecolor			1 .682 0 1
			visible			1
			cvartest			"ui_loggedin"
			showcvar			{ "0" }
			action
			{
				play			"sound/interface/button1"
				open			ingame_register
				close 			ingame_player
			}
			mouseEnter
			{
				show			registerButton
			}
			mouseExit
			{
				hide			registerButton
			}
		}

//LOG IN BUTTON (logged-out, slot 2)
		itemDef
		{
			name				loginButton
			group				highlights
			style				WINDOW_STYLE_SHADER
			rect				73 70 105 32
			background			"gfx/menus/menu_buttonback"			// Frame around button
			forecolor			1 1 1 1
			decoration
			visible			0
			cvartest			"ui_loggedin"
			showcvar			{ "0" }
		}

		itemDef
		{
			name				login
			group				none
			text				"Log in"
			type				1
			style				WINDOW_STYLE_EMPTY
			rect				73 70 105 32
			textalign			ITEM_ALIGN_CENTER
			textalignx			52
			textaligny			2
			font				2
			textscale			1
			forecolor			1 .682 0 1
			visible			1
			cvartest			"ui_loggedin"
			showcvar			{ "0" }
			action
			{
				play			"sound/interface/button1"
				open			ingame_login
				close 			ingame_player
			}
			mouseEnter
			{
				show			loginButton
			}
			mouseExit
			{
				hide			loginButton
			}
		}

//LOGOUT BUTTON (logged-in, slot 1)
		itemDef
		{
			name				logoutButton
			group				highlights
			style				WINDOW_STYLE_SHADER
			rect				73 40 105 32
			background			"gfx/menus/menu_buttonback"			// Frame around button
			forecolor			1 1 1 1
			decoration
			visible			0
			cvartest			"ui_loggedin"
			showcvar			{ "1" }
		}

		// GalaxyRP: [Profile UI] moved out of ingame_login.menu (where it sat confusingly next to the
		// username/password fields and the Login button) onto the Account menu itself, alongside
		// Change Pass, matching how a logged-in player actually thinks about these two actions.
		itemDef
		{
			name				logout
			group				none
			text				"Logout"
			type				1
			style				WINDOW_STYLE_EMPTY
			rect				73 40 105 32
			textalign			ITEM_ALIGN_CENTER
			textalignx			52
			textaligny			2
			font				2
			textscale			1
			forecolor			1 .682 0 1
			visible			1
			cvartest			"ui_loggedin"
			showcvar			{ "1" }
			action
			{
				play			"sound/interface/button1"
				exec			"logout"
				hide			highlights
				uiScript 		closeingame
			}
			mouseEnter
			{
				show			logoutButton
			}
			mouseExit
			{
				hide			logoutButton
			}
		}

//CHANGE PASS BUTTON (logged-in, slot 2)
		itemDef
		{
			name				changepassButton
			group				highlights
			style				WINDOW_STYLE_SHADER
			rect				73 70 105 32
			background			"gfx/menus/menu_buttonback"			// Frame around button
			forecolor			1 1 1 1
			decoration
			visible			0
			cvartest			"ui_loggedin"
			showcvar			{ "1" }
		}

		itemDef
		{
			name				changepass
			group				none
			text				"Change Pass"
			type				1
			style				WINDOW_STYLE_EMPTY
			rect				73 70 105 32
			textalign			ITEM_ALIGN_CENTER
			textalignx			52
			textaligny			2
			font				2
			textscale			1
			forecolor			1 .682 0 1
			visible			1
			cvartest			"ui_loggedin"
			showcvar			{ "1" }
			action
			{
				play			"sound/interface/button1"
				open			ingame_passchange
				close 			ingame_player
			}
			mouseEnter
			{
				show			changepassButton
			}
			mouseExit
			{
				hide			changepassButton
			}
		}

//JOIN OR SPECTATE BUTTON (slot 3, always available regardless of login state)
		itemDef
		{
			name				joinOrSpectateButton
			group				highlights
			style				WINDOW_STYLE_SHADER
			rect				73 100 105 32
			background			"gfx/menus/menu_buttonback"			// Frame around button
			forecolor			1 1 1 1
			decoration
			visible			0
		}

		// GalaxyRP: [Profile UI] mirrors the top-bar "Join" button in ingame.menu -- same target (the
		// vanilla ingame_join popup with its own Join/Auto team/Red/Blue/Spectate buttons), just
		// reachable from the Account menu as well. GalaxyRP fix: [UI] the cvarTest "ui_singleplayeractive"
		// / disableCvar {"1"} block that used to gray this out in Solo Game mode has been removed to
		// match the top-bar Join button, which was never actually gated the same way (see ingame.menu).
		itemDef
		{
			name				joinOrSpectate
			group				none
			text				"Join or Spectate"
			type				1
			style				WINDOW_STYLE_EMPTY
			rect				73 100 105 32
			textalign			ITEM_ALIGN_CENTER
			textalignx			52
			textaligny			2
			font				2
			textscale			1
			forecolor			1 .682 0 1
			visible			1
			action
			{
				play			"sound/interface/button1"
				open			ingame_join
				close 			ingame_player
			}
			mouseEnter
			{
				show			joinOrSpectateButton
			}
			mouseExit
			{
				hide			joinOrSpectateButton
			}
		}

	}
}
