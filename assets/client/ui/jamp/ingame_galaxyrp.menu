		itemDef 
		{
			name				commandsButton
			group				mainButtons
			text				"Shop"
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				10 138 140 30
			font				3
			textscale			0.8
			textalignx			15
			textaligny			5
			textalign			ITEM_ALIGN_LEFT
			textstyle			3
			forecolor			1 .682 0 1
			visible				0
			// GalaxyRP: [Profile UI] the shop spends RPG credits, which only a logged-in account has.
			cvarTest			"ui_loggedin"
			showCvar
			{
				"1"
			}
			descText			"Buy gear, ammunition, and upgrades"

			mouseEnter 
			{ 
				show			commandsButton_glow
			}
			mouseExit 
			{ 
				hide			commandsButton_glow
			}	  	  
			action 
			{ 
				play			"sound/interface/button1.wav" ;
				show 			commandsControls ;
				hide			charControls ;
				hide			changePassControls ;
				hide 			rpgClassControls ;
				hide 			upControls ;
				hide 			forceLoginSkillsControls ;
				hide			weaponSkillsControls ;
				hide			otherSkillsControls ;
				hide			ammoSkillsControls ;
				hide			itemsSkillsControls ;
				hide			questControls ;
				hide			universeControls ;
				hide			lightControls ;
				hide			darkControls ;
				hide			eternityControls ;
				hide			questMapsControls ;
				hide 			listControls ;
				hide			levelweapon ;
				hide			levelother ;
				hide			levelammo ;
				hide			levelitem ;
				hide 			buyControls ;
				hide 			buyAmmoControls ;
				hide 			buyWeaponsControls ;
				hide 			buyMiscControls ;
				hide 			cameraControls ;
				hide 			extrasControls ;
				setitemcolor		mainButtons 		forecolor 1 .682 0 1 ;
				setitemcolor		commandsButton		forecolor 1 1 1 1 ;
				// GalaxyRP fix: [Shop] clear the Upgrades/Ammo/Misc strip's own highlight too, the same
				// repair upButton ("Skills") needed for its tab strip and for the same reason:
				// setitemcolor writes window.foreColor on the loaded menu and nothing puts it back on
				// its own, so the white a shop tab paints on itself when clicked survived every trip
				// back through this button. This is the only place that shows commandsControls, and it
				// shows the strip with all three panel bodies hidden, so whichever tab was clicked last
				// sat there still lit above an empty pane. Upgrades most of the time, being the top of
				// the strip.
				//
				// One line rather than the two the Skills strip needs: all three members of
				// commandsControls are plain 1 .682 0 tabs, so there is no odd colour to put back
				// afterwards the way forceSkillsButton's light blue has to be.
				setitemcolor		commandsControls	forecolor 1 .682 0 1 ;
			}
		}

		// GalaxyRP: [Profile UI] the "Games" sidebar button (gamesButton/gamesButton_glow, rect y 168)
		// used to sit here, between Shop above and Camera below. See the matching note further down
		// where its panel was.
		// GalaxyRP: [Extras] the "Extras" button took its place: props, effects, NPCs and vehicles,
		// music and sounds, each in a menu of its own (ingame_rpx_*.menu, ui_rpextras.c). The server
		// refuses what a player may not do, so only the login gates it, as the buttons above.

		itemDef
		{
			name				extrasButton_glow
			style				WINDOW_STYLE_SHADER
			rect				5 168 140 30
			background			"gfx/menus/menu_blendbox2"
			forecolor			1 1 1 1
			visible				0
			decoration
			cvarTest			"ui_loggedin"
			showCvar
			{
				"1"
			}
		}

