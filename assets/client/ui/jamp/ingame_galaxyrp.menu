		{
			name				extrasButton
			group				mainButtons
			text				"Extras"
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				10 168 140 30
			font				3
			textscale			0.8
			textalignx			15
			textaligny			5
			textalign			ITEM_ALIGN_LEFT
			textstyle			3
			forecolor			1 .682 0 1
			visible				0
			cvarTest			"ui_loggedin"
			showCvar
			{
				"1"
			}
			descText			"Spawn props, effects, NPCs and vehicles, play music and sounds"

			mouseEnter
