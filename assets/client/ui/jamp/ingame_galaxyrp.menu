		itemDef 
		{
			name				buyButton_glow
			style				WINDOW_STYLE_SHADER
			rect				160 50 150 24
			background			"gfx/menus/menu_blendbox2"
			forecolor			1 1 1 1
			visible				0
			decoration
		}

		itemDef 
		{
			name				buyButton
			group				commandsControls
			text				"Upgrades"
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				160 50 150 24
			font				3
			textscale			0.6
			textalignx			15
			textaligny			5
			textalign			ITEM_ALIGN_LEFT
			textstyle			3
			forecolor			1 .682 0 1
			visible				0
			descText			"Buy upgrades from the jawa seller"

			mouseEnter
			{
				show			buyButton_glow
			}
			mouseExit
			{
				hide			buyButton_glow
			}
			action
			{
				play			"sound/interface/button1.wav" ;
				show 			buyControls ;
				hide 			buyAmmoControls ;
				hide 			buyWeaponsControls ;
				hide 			buyMiscControls ;
				setitemcolor		commandsControls forecolor 1 .682 0 1 ;
				setitemcolor		buyButton forecolor 1 1 1 1 ;
				// GalaxyRP fix: [Shop] refresh the owned-upgrade sync (ui_zyk_upgrade_1/2/3_owned) every
				// time this panel is opened, so buy0Button/buy4Button/buy10Button's greyed-out state is
				// always current -- covers a purchase made earlier in the session before this specific
				// menu box was reopened, on top of the immediate per-purchase refresh those buttons'
				// own actions already do.
				exec			"zykmod" ;
			}
		}

		// GalaxyRP fix: [Shop] cvarTest/disableCvar gate added -- greys out (via the menuDef's new
		// disableColor above) and disables this button once ui_zyk_upgrade_1_owned reads "1" (synced
		// from player_settings bit 0 by Cmd_GalaxyRpUi_f/CG_ZykMod, see the matching comments in
		// g_cmds.c and cg_servercmds.c), so a player who already owns Holdable Items Upgrade can't
		// click a purchase Cmd_Buy_f's own duplicate-purchase guard would reject anyway with a "You
		// already have..." message.
		// GalaxyRP fix: [Shop] this action used to also send "exec zykmod" right after the purchase, to
		// grey the button out immediately without leaving and reopening this panel -- removed. Buying
		// all 3 upgrades in quick succession (each purchase already prints a confirmation, plus this
		// panel's own "exec buy upgrade N") could stack up enough server->client reliable commands to
		// trip the engine's "Server command overflow" client-drop protection (MAX_RELIABLE_COMMANDS,
		// sv_main.cpp), especially on a busier server. buyButton's own onOpen handler above already
		// does an "exec zykmod" refresh every time this Shop panel is (re)opened, so the greyed-out
		// state still catches up correctly -- just on the next open instead of instantly on purchase.
		itemDef
		{
			name				buy0Button
			group				buyControls
			text				"Holdable Items Upgrade - 30000"
			descText			""
			type				1
			font				3
			textscale			.4
			style				WINDOW_STYLE_FILLED
			rect				320 50 180 12
			textalign			ITEM_ALIGN_LEFT
			forecolor			1 .682 0 1
			visible				0
			cvarTest			"ui_zyk_upgrade_1_owned"
			disableCvar
			{
				"1"
			}
			action
			{
				// GalaxyRP fix: [Shop] renumbered to /buy upgrade <n> -- Holdable Items Upgrade is now
				// upgrade 1 (was flat product id 40).
				exec			"buy upgrade 1"
				play			"sound/interface/button1.wav" ;
			}
		}

		// GalaxyRP fix: [Shop] same cvarTest/disableCvar gate as buy0Button above, bound to
		// ui_zyk_upgrade_2_owned (player_settings bit 1) for Impact Reducer.
		itemDef
		{
			name				buy4Button
			group				buyControls
			text				"Impact Reducer - 40000"
			descText			""
			type				1
			font				3
			textscale			.4
			style				WINDOW_STYLE_FILLED
			rect				320 65 180 12
			textalign			ITEM_ALIGN_LEFT
			forecolor			1 .682 0 1
			visible				0
			cvarTest			"ui_zyk_upgrade_2_owned"
			disableCvar
			{
				"1"
			}
			action
			{
				// GalaxyRP fix: [Shop] renumbered to /buy upgrade <n> -- Impact Reducer is now
				// upgrade 2 (was flat product id 15).
				// GalaxyRP fix: [Shop] "exec zykmod" removed here -- see the matching comment on
				// buy0Button above for why.
				exec			"buy upgrade 2"
				play			"sound/interface/button1.wav" ;
			}
		}

