//----------------------------------------------------------------------------------------------
// INGAME GALAXY RP BOX 
//----------------------------------------------------------------------------------------------
{
	menuDef  
	{
		name					"ingame_galaxyrp"
		visible					0
		fullscreen				0
		outOfBoundsClick									// this closes the window if it gets a click out of the rectangle
		rect					30 35 570 400
		focusColor				1 1 1 1								// Focus color for text and items
		// GalaxyRP fix: [Shop] added so the Shop -> Upgrades panel's cvarTest/disableCvar-gated buttons
		// (buy0Button/buy4Button/buy10Button) actually render greyed out once owned, instead of
		// invisible -- Item_Paint (ui_shared.c) substitutes this color for a disabled item's forecolor,
		// and this menuDef never set one before, which defaults the field to fully transparent (alpha
		// 0). Matches the grey ingame.menu itself already uses for the same purpose.
		disableColor			0.5 0.5 0.5 1
		style					1
		border					1
		descX					305
		descY					400
		descScale				1
		descColor				1 .682 0 .8					// Focus color for text and items
		descAlignment			ITEM_ALIGN_CENTER		

		onClose 
		{
			hide	mainButtons ;
		}

		onESC 
		{ 
			play				"sound/interface/button1.wav" ;
			close				ingame_galaxyrp
		}

		onopen 
		{ 
			show 			mainButtons ;
			uiScript		update "ui_GetName"
			exec 			"zykmod" ;
			hide			charControls ;
			hide 			rpgClassControls ;
			hide 			upControls ;
			hide 			forceLoginSkillsControls ;
			hide			weaponSkillsControls ;
			hide			otherSkillsControls ;
			hide			ammoSkillsControls ;
			hide			itemsSkillsControls ;
			hide			questControls ;
			hide			universeControls ;
			hide			lightControls ;
			hide			darkControls ;
			hide			eternityControls ;
			hide			questMapsControls ;
			show 			listControls ;
			hide 			commandsControls ;
			hide			levelweapon ;
			hide			levelother ;
			hide			levelammo ;
			hide			levelitem ;
			hide 			buyControls ;
			hide 			buyAmmoControls ;
			hide 			buyWeaponsControls ;
			hide 			buyMiscControls ;
			hide 			cameraControls ;
			hide 			extrasControls ;
			// GalaxyRP: [Extras] back from an Extras menu: its Extras tab (ui_rpextras.c)
			uiScript		rpxBackTab
		}

		itemDef 
		{
			name				galaxyrp_mainwindowbackground
			group				mainButtons
			style				WINDOW_STYLE_SHADER
			rect				0 0 570 400
			background			"gfx/menus/menu_box_ingame"
			forecolor			1 1 1 1
			visible				0
			decoration
		}

		itemDef 
		{
			name				zyk_playerconfigtitle
			group				mainButtons
			style				WINDOW_STYLE_SHADER
			background			"gfx/menus/menu_blendbox"
			text				"^6Galaxy ^4RP^3 Mod Management"
			rect				20 5 510 28
			textalign			ITEM_ALIGN_CENTER		
			textalignx			255
			textaligny			2
			outlinecolor			1 .5 .5 .5
			backcolor			0 0 0 0
			font				3
			textscale			0.9
			forecolor			.549 .854 1 1
			border				0
			bordercolor			0 0 0 0
			visible				0
		}

//----------------------------------------------------------------------------------------------
// Leftside Menu Items
//----------------------------------------------------------------------------------------------
		
		itemDef 
		{
			name				listButton_glow
			style				WINDOW_STYLE_SHADER
			rect				5 48 140 30
			background			"gfx/menus/menu_blendbox2"
			forecolor			1 1 1 1
			visible				0
			decoration
		}

		itemDef 
		{
			name				listButton
			group				mainButtons
			text				"Customize"
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				10 48 140 30
			font				3
			textscale			0.8
			textalignx			15
			textaligny			5
			textalign			ITEM_ALIGN_LEFT
			textstyle			3
			forecolor			1 .682 0 1
			visible				0
			descText			"Shows the information about your current character"

			mouseEnter 
			{ 
				show			listButton_glow
			}
			mouseExit 
			{ 
				hide			listButton_glow
			}	  	  
			action 
			{ 
				play			"sound/interface/button1.wav" ;
				exec 			"zykmod" ;
				show 			listControls ;
				hide			charControls ;
				hide			changePassControls ;
				hide 			rpgClassControls ;
				hide 			forceLoginSkillsControls ;
				hide			weaponSkillsControls ;
				hide			otherSkillsControls ;
				hide			ammoSkillsControls ;
				hide			itemsSkillsControls ;
				hide			questControls ;
				hide			universeControls ;
				hide			lightControls ;
				hide			darkControls ;
				hide			eternityControls ;
				hide			questMapsControls ;
				hide 			upControls ;
				hide 			commandsControls ;
				hide			levelweapon ;
				hide			levelother ;
				hide			levelammo ;
				hide			levelitem ;
				hide 			buyControls ;
				hide 			buyAmmoControls ;
				hide 			buyWeaponsControls ;
				hide 			buyMiscControls ;
				hide 			cameraControls ;
				hide 			extrasControls ;
				setitemcolor		mainButtons 		forecolor 1 .682 0 1 ;
				setitemcolor		listButton		forecolor 1 1 1 1 ;
			}
		}

				itemDef 
		{
			name				upButton_glow
			style				WINDOW_STYLE_SHADER
			rect				5 78 140 30
			background			"gfx/menus/menu_blendbox2"
			forecolor			1 1 1 1
			visible				0
			decoration
			cvarTest			"ui_loggedin"
			showCvar
			{
				"1"
			}
		}

		itemDef 
		{
			name				upButton
			group				mainButtons
			text				"Skills"
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				10 78 140 30
			font				3
			textscale			0.8
			textalignx			15
			textaligny			5
			textalign			ITEM_ALIGN_LEFT
			textstyle			3
			forecolor			1 .682 0 1
			visible				0
			// GalaxyRP: [Profile UI] Skills only make sense for a logged-in account.
			cvarTest			"ui_loggedin"
			showCvar
			{
				"1"
			}
			descText			"Check your character's skill levels"

			mouseEnter 
			{ 
				show			upButton_glow
			}
			mouseExit 
			{ 
				hide			upButton_glow
			}	  	  
			action 
			{ 
				play			"sound/interface/button1.wav" ;
				exec 			"zykmod" ;
				show 			upControls ;
				hide			charControls ;
				hide			changePassControls ;
				hide 			rpgClassControls ;
				hide 			forceLoginSkillsControls ;
				hide			weaponSkillsControls ;
				hide			otherSkillsControls ;
				hide			ammoSkillsControls ;
				hide			itemsSkillsControls ;
				hide			questControls ;
				hide			universeControls ;
				hide			lightControls ;
				hide			darkControls ;
				hide			eternityControls ;
				hide			questMapsControls ;
				hide 			listControls ;
				hide 			commandsControls ;
				hide			levelweapon ;
				hide			levelother ;
				hide			levelammo ;
				hide			levelitem ;
				hide 			buyControls ;
				hide 			buyAmmoControls ;
				hide 			buyWeaponsControls ;
				hide 			buyMiscControls ;
				hide 			cameraControls ;
				hide 			extrasControls ;
				setitemcolor		mainButtons 		forecolor 1 .682 0 1 ;
				setitemcolor		upButton		forecolor 1 1 1 1 ;
				// GalaxyRP fix: [Profile UI] clear the tab strip's own highlight too. setitemcolor
				// writes window.foreColor on the loaded menu and nothing ever puts it back on its own
				// -- the menu is parsed once at UI init, and opening or closing it only toggles
				// visibility -- so the white a tab paints on itself outlived every trip through this
				// button. This is the only place that shows upControls, and it shows the strip with
				// every tab body hidden, so whichever tab was clicked last sat there looking selected
				// above an empty pane until another tab was clicked. Weapons most of the time, being
				// the top of the strip and so the first one anybody clicks.
				//
				// Same two lines the four tab actions use, for the same reason: the group repaint
				// covers forceSkillsButton as well, so its own light blue goes back on afterwards.
				setitemcolor		upControls		forecolor 1 .682 0 1 ;
				setitemcolor		forceSkillsButton	forecolor .549 .854 1 1 ;
			}
		}

		itemDef 
		{
			name				charButton_glow
			style				WINDOW_STYLE_SHADER
			rect				5 108 140 30
			background			"gfx/menus/menu_blendbox2"
			forecolor			1 1 1 1
			visible				0
			decoration
			cvarTest			"ui_loggedin"
