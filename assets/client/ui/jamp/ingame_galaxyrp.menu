			textalign			ITEM_ALIGN_LEFT
			textstyle			3
			forecolor			1 .682 0 1
			visible				0
			// GalaxyRP: [Profile UI] character management only makes sense for a logged-in account.
			cvarTest			"ui_loggedin"
			showCvar
			{
				"1"
			}
			descText			"Manage your characters. You can also change via /char in console"

			mouseEnter 
			{ 
				show			charButton_glow
			}
			mouseExit 
			{ 
				hide			charButton_glow
			}	  	  
			action 
			{ 
				play			"sound/interface/button1.wav" ;
				exec 			"zykchars" ;
				show 			charControls ;
				hide			upControls ;
				hide			changePassControls ;
				hide 			rpgClassControls ;
				hide 			forceLoginSkillsControls ;
				hide			weaponSkillsControls ;
				hide			otherSkillsControls ;
				hide			ammoSkillsControls ;
				hide			itemsSkillsControls ;
				hide			questControls ;
				hide			universeControls ;
				hide			lightControls ;
				hide			darkControls ;
				hide			eternityControls ;
				hide			questMapsControls ;
				hide 			listControls ;
				hide 			commandsControls ;
				hide			levelweapon ;
				hide			levelother ;
				hide			levelammo ;
				hide			levelitem ;
				hide 			buyControls ;
				hide 			buyAmmoControls ;
				hide 			buyWeaponsControls ;
				hide 			buyMiscControls ;
				hide 			cameraControls ;
				hide 			extrasControls ;
				setitemcolor		mainButtons 		forecolor 1 .682 0 1 ;
				setitemcolor		charButton		forecolor 1 1 1 1 ;
			}
		}

		itemDef 
		{
			name				commandsButton_glow
			style				WINDOW_STYLE_SHADER
