		itemDef
		{
			name				forceLogin
			group				listControls
			background			"gfx/menus/forcepbtn"
			descText			"Manage your Force power skills"
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_SHADER
			rect				465 305 75 75
			font				3
			textscale			1
			textaligny			-1
			textalign			ITEM_ALIGN_CENTER
			textstyle			3
			forecolor			.5 .5 .5 1
			visible			1
			cvarTest			"ui_loggedin"
			showCvar
			{
				"1"
			}
			mouseEnter
			{
				setitemcolor		forceLogin	forecolor	1 1 1 1
			}
			mouseExit
			{
				setitemcolor		forceLogin	forecolor	.5 .5 .5 1
			}
	     		action
			{
				play			"sound/interface/button1.wav" ;
				// GalaxyRP fix: [Profile UI] added exec "zykmod" here 2026-09-02, matching upButton
				// ("Skills") -- Force power levels are server-side account data synced through the same
				// zykmod payload as regular skills (see the skills[] loop in Cmd_GalaxyRpUi_f, g_cmds.c),
				// so without this the panel only ever showed whatever was synced the last time the menu
				// was opened or Skills/Customize was clicked, instead of the player's current force
				// power levels.
				exec			"zykmod" ;
				hide			listControls ;
				hide			charControls ;
				hide			changePassControls ;
				hide			rpgClassControls ;
				hide			upControls ;
				hide			weaponSkillsControls ;
				hide			otherSkillsControls ;
				hide			ammoSkillsControls ;
				hide			itemsSkillsControls ;
				hide			questControls ;
				hide			universeControls ;
				hide			lightControls ;
				hide			darkControls ;
				hide			eternityControls ;
				hide			questMapsControls ;
				hide			commandsControls ;
				hide			levelweapon ;
				hide			levelother ;
				hide			levelammo ;
				hide			levelitem ;
				hide			buyControls ;
				hide			buyAmmoControls ;
				hide			buyWeaponsControls ;
				hide			buyMiscControls ;
				hide			cameraControls ;
				show			forceLoginSkillsControls ;
			}
		}

