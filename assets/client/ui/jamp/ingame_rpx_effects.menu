			rect                432 58 180 18
			textalign           ITEM_ALIGN_LEFT
			textalignx          0
			textaligny          -2
			font                2
			textscale           0.7
			forecolor           1 1 1 1
			visible             1
			descText            "Spawned effect: up, at you, or at you tilted; the preview shows it"
