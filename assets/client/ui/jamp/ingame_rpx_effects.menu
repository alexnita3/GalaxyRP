			type                ITEM_TYPE_BUTTON
			style               WINDOW_STYLE_FILLED
			rect                232 206 92 20
			text                "Preview"
			textalign           ITEM_ALIGN_CENTER
			textalignx          46
			textaligny          2
			font                2
			textscale           0.7
			forecolor           1 .682 0 1
			backcolor           0 0 0 .6
			border              1
			bordercolor         1 .682 0 .6
			visible             1
			descText            "Preview only: play the selected effect in the box (press again to replay)"
			mouseEnter
			{
				setitemcolor rpx_preview_btn bordercolor 1 1 1 1
			}
			mouseExit
			{
				setitemcolor rpx_preview_btn bordercolor 1 .682 0 .6
			}
