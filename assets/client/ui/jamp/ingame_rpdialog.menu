//----------------------------------------------------------------------------------------------
// ingame_rpdialog: a script's dialogue (Lua, Dialog.open), in the middle of the screen.
// GLX_U: [Lua] cgame (cg_rpdialog.c) fills the ui_rpdlg_* cvars and opens it; ui_rpdialog.c sends the
// answer. ui/rp_dialog.h says how they work together. The text lines and the options are font 2 at
// textscale 0.58 in a column 572 wide, the title font 2 at 0.7: cgame breaks the text into lines for
// exactly that (RPDLG_TEXT_SCALE, RPDLG_TEXT_WIDTH, RPDLG_TITLE_SCALE), so change them together.
// An option is clicked, or its number pressed (1 to 6) while the menu is open; Esc, or anything else
// that closes the menu without an answer, ends the conversation (onClose).
//----------------------------------------------------------------------------------------------
{
	menuDef
	{
		name                    "ingame_rpdialog"
		visible                 0
		fullscreen              0
		rect                    20 100 600 280
		focusColor              1 1 1 1
		style                   1
		border                  1

		onClose
		{
			uiScript		rpDialogClosed
		}
		onESC
		{
			uiScript		rpDialogClosed ;
			close			ingame_rpdialog
		}

		itemDef
		{
			name                rpdlg_box
			style               WINDOW_STYLE_SHADER
			rect                0 0 600 280
			background          "gfx/menus/menu_box_ingame"
			forecolor           1 1 1 1
			visible             1
			decoration
		}
		itemDef
		{
			name                rpdlg_title
			type                ITEM_TYPE_TEXT
			style               WINDOW_STYLE_EMPTY
			rect                14 8 572 18
			cvar                "ui_rpdlg_title"
			textalign           ITEM_ALIGN_LEFT
			textalignx          0
			textaligny          0
			font                2
			textscale           0.7
			forecolor           .549 .854 1 1
			visible             1
			decoration
		}
		itemDef
		{
			name                rpdlg_textbox
			style               WINDOW_STYLE_FILLED
			rect                10 30 580 122
			backcolor           0 0 0 .35
			visible             1
			decoration
		}
		itemDef
		{
			name                rpdlg_line1
			type                ITEM_TYPE_TEXT
			style               WINDOW_STYLE_EMPTY
			rect                14 34 572 16
			cvar                "ui_rpdlg_line1"
			textalign           ITEM_ALIGN_LEFT
			textalignx          0
			textaligny          0
			font                2
			textscale           0.58
			forecolor           1 1 1 1
			visible             1
			decoration
		}
		itemDef
		{
			name                rpdlg_line2
			type                ITEM_TYPE_TEXT
			style               WINDOW_STYLE_EMPTY
			rect                14 50 572 16
			cvar                "ui_rpdlg_line2"
			textalign           ITEM_ALIGN_LEFT
			textalignx          0
			textaligny          0
			font                2
			textscale           0.58
			forecolor           1 1 1 1
			visible             1
			decoration
		}
		itemDef
		{
			name                rpdlg_line3
			type                ITEM_TYPE_TEXT
			style               WINDOW_STYLE_EMPTY
			rect                14 66 572 16
			cvar                "ui_rpdlg_line3"
			textalign           ITEM_ALIGN_LEFT
			textalignx          0
			textaligny          0
			font                2
			textscale           0.58
			forecolor           1 1 1 1
			visible             1
			decoration
		}
		itemDef
		{
