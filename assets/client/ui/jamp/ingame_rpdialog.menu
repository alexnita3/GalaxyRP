			name                rpdlg_hint
			type                ITEM_TYPE_TEXT
			style               WINDOW_STYLE_EMPTY
			rect                14 262 470 14
			text                "Click an answer or press its number. Esc ends the conversation."
			textalign           ITEM_ALIGN_LEFT
			textalignx          0
