		itemDef
		{
			name                rpdlg_opt5
			type                ITEM_TYPE_BUTTON
			style               WINDOW_STYLE_FILLED
			rect                14 226 572 17
			cvar                "ui_rpdlg_opt5"
			textalign           ITEM_ALIGN_LEFT
			textalignx          4
			textaligny          2
			font                2
			textscale           0.58
			forecolor           1 1 1 1
			backcolor           0 0 0 0
			visible             1
			cvarTest            "ui_rpdlg_count"
			showCvar            { "5" "6" }
			mouseEnter
			{
