			type                ITEM_TYPE_TEXT
			style               WINDOW_STYLE_EMPTY
			rect                14 82 572 16
			cvar                "ui_rpdlg_line4"
			textalign           ITEM_ALIGN_LEFT
			textalignx          0
			textaligny          0
			font                2
			textscale           0.58
			forecolor           1 1 1 1
			visible             1
			decoration
		}
		itemDef
		{
			name                rpdlg_line5
			type                ITEM_TYPE_TEXT
			style               WINDOW_STYLE_EMPTY
			rect                14 98 572 16
			cvar                "ui_rpdlg_line5"
			textalign           ITEM_ALIGN_LEFT
			textalignx          0
			textaligny          0
			font                2
			textscale           0.58
			forecolor           1 1 1 1
			visible             1
			decoration
		}
		itemDef
		{
