			type                ITEM_TYPE_TEXT
			style               WINDOW_STYLE_EMPTY
			rect                14 114 572 16
			cvar                "ui_rpdlg_line6"
			textalign           ITEM_ALIGN_LEFT
			textalignx          0
			textaligny          0
			font                2
			textscale           0.58
			forecolor           1 1 1 1
			visible             1
			decoration
		}
		itemDef
		{
			name                rpdlg_line7
			type                ITEM_TYPE_TEXT
			style               WINDOW_STYLE_EMPTY
			rect                14 130 572 16
			cvar                "ui_rpdlg_line7"
			textalign           ITEM_ALIGN_LEFT
			textalignx          0
			textaligny          0
			font                2
			textscale           0.58
			forecolor           1 1 1 1
			visible             1
			decoration
		}
		itemDef
		{
			name                rpdlg_opt1
			type                ITEM_TYPE_BUTTON
			style               WINDOW_STYLE_FILLED
			rect                14 158 572 17
			cvar                "ui_rpdlg_opt1"
			textalign           ITEM_ALIGN_LEFT
			textalignx          4
			textaligny          2
			font                2
			textscale           0.58
			forecolor           1 1 1 1
			backcolor           0 0 0 0
			visible             1
			cvarTest            "ui_rpdlg_count"
			showCvar            { "1" "2" "3" "4" "5" "6" }
			mouseEnter
			{
				setitemcolor rpdlg_opt1 backcolor 1 .682 0 .25
			}
			mouseExit
			{
				setitemcolor rpdlg_opt1 backcolor 0 0 0 0
			}
			action
			{
				play "sound/interface/button1.wav" ;
				uiScript rpDialogChoose 1
			}
		}
		itemDef
		{
			name                rpdlg_opt2
			type                ITEM_TYPE_BUTTON
			style               WINDOW_STYLE_FILLED
			rect                14 175 572 17
			cvar                "ui_rpdlg_opt2"
			textalign           ITEM_ALIGN_LEFT
			textalignx          4
			textaligny          2
			font                2
			textscale           0.58
			forecolor           1 1 1 1
			backcolor           0 0 0 0
			visible             1
			cvarTest            "ui_rpdlg_count"
			showCvar            { "2" "3" "4" "5" "6" }
			mouseEnter
			{
				setitemcolor rpdlg_opt2 backcolor 1 .682 0 .25
			}
			mouseExit
			{
				setitemcolor rpdlg_opt2 backcolor 0 0 0 0
			}
			action
			{
				play "sound/interface/button1.wav" ;
